@model BireyselHesaplar.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Sifreyi Yenile";
    ViewData["HideChrome"] = true;
}

<style>
    .auth-wrap {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background:
            linear-gradient(135deg, rgba(2, 6, 23, 0.84), rgba(15, 23, 42, 0.7)),
            url("https://images.unsplash.com/photo-1516387938699-a93567ec168e?auto=format&fit=crop&w=2200&q=80") center/cover no-repeat;
    }

    .auth-glass {
        width: min(520px, 100%);
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: linear-gradient(160deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.12));
        backdrop-filter: blur(11px);
        -webkit-backdrop-filter: blur(11px);
        box-shadow: 0 18px 36px rgba(2, 6, 23, 0.35);
    }

    .auth-title {
        font-size: clamp(1.7rem, 2.8vw, 2.1rem);
        font-weight: 800;
        color: #f8fafc;
        margin-bottom: 6px;
    }

    .auth-subtitle {
        color: rgba(241, 245, 249, 0.88);
        margin-bottom: 20px;
    }

    .auth-label {
        color: #e2e8f0;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .auth-input {
        border-radius: 12px;
        border: 1px solid rgba(148, 163, 184, 0.5);
        background: rgba(255, 255, 255, 0.92);
        min-height: 46px;
    }

    .auth-input:focus {
        border-color: #60a5fa;
        box-shadow: 0 0 0 0.2rem rgba(96, 165, 250, 0.26);
    }

    .auth-btn {
        border: none;
        border-radius: 12px;
        min-height: 48px;
        font-weight: 700;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        box-shadow: 0 10px 22px rgba(59, 130, 246, 0.35);
    }

    .auth-btn:hover {
        filter: brightness(1.04);
    }

    .auth-link {
        color: #bfdbfe;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-link:hover {
        color: #dbeafe;
        text-decoration: underline;
    }
</style>

<div class="auth-wrap">
    <div class="auth-glass p-4 p-md-5">
        <h1 class="auth-title">Yeni Sifre Belirle</h1>
        <p class="auth-subtitle">Guvenli bir yeni sifre belirleyip hesabina giris yapabilirsin.</p>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2">@ViewBag.Error</div>
            <div class="text-center">
                <a class="auth-link" asp-controller="Account" asp-action="ForgotPassword">Yeni link olustur</a>
            </div>
        }
        else
        {
            <form asp-action="ResetPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label auth-label"></label>
                    <input asp-for="NewPassword" type="password" class="form-control auth-input" autocomplete="new-password" placeholder="********" />
                    <span asp-validation-for="NewPassword" class="text-warning small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label auth-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control auth-input" autocomplete="new-password" placeholder="********" />
                    <span asp-validation-for="ConfirmPassword" class="text-warning small"></span>
                </div>

                <button type="submit" class="btn btn-primary auth-btn w-100 mb-3">Sifreyi Guncelle</button>

                <div class="text-center text-white-50">
                    <a class="auth-link" asp-controller="Account" asp-action="Login">Giris ekranina don</a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
