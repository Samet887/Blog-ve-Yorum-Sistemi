@model BireyselHesaplar.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Sifremi Unuttum";
    ViewData["HideChrome"] = true;
}

<style>
    .auth-wrap {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
        background:
            linear-gradient(135deg, rgba(2, 6, 23, 0.84), rgba(15, 23, 42, 0.7)),
            url("https://images.unsplash.com/photo-1496302662116-35cc4f36df92?auto=format&fit=crop&w=2200&q=80") center/cover no-repeat;
    }

    .auth-glass {
        width: min(520px, 100%);
        border-radius: 22px;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: linear-gradient(160deg, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0.12));
        backdrop-filter: blur(11px);
        -webkit-backdrop-filter: blur(11px);
        box-shadow: 0 18px 36px rgba(2, 6, 23, 0.35);
    }

    .auth-title {
        font-size: clamp(1.7rem, 2.8vw, 2.1rem);
        font-weight: 800;
        color: #f8fafc;
        margin-bottom: 6px;
    }

    .auth-subtitle {
        color: rgba(241, 245, 249, 0.88);
        margin-bottom: 20px;
    }

    .auth-label {
        color: #e2e8f0;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .auth-input {
        border-radius: 12px;
        border: 1px solid rgba(148, 163, 184, 0.5);
        background: rgba(255, 255, 255, 0.92);
        min-height: 46px;
    }

    .auth-input:focus {
        border-color: #60a5fa;
        box-shadow: 0 0 0 0.2rem rgba(96, 165, 250, 0.26);
    }

    .auth-btn {
        border: none;
        border-radius: 12px;
        min-height: 48px;
        font-weight: 700;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        box-shadow: 0 10px 22px rgba(59, 130, 246, 0.35);
    }

    .auth-btn:hover {
        filter: brightness(1.04);
    }

    .auth-link {
        color: #bfdbfe;
        text-decoration: none;
        font-weight: 600;
    }

    .auth-link:hover {
        color: #dbeafe;
        text-decoration: underline;
    }

    .reset-link-box {
        border: 1px solid rgba(148, 163, 184, 0.45);
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.94);
        padding: 12px;
        word-break: break-all;
    }
</style>

<div class="auth-wrap">
    <div class="auth-glass p-4 p-md-5">
        <h1 class="auth-title">Sifre Sifirlama</h1>
        <p class="auth-subtitle">Kullanici adi ve e-posta bilgini gir. Gecici sifre yenileme baglantisi olusturalim.</p>

        <form asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success py-2">@ViewBag.Success</div>
            }

            <div class="mb-3">
                <label asp-for="UserName" class="form-label auth-label"></label>
                <input asp-for="UserName" class="form-control auth-input" autocomplete="username" placeholder="kullaniciadi" />
                <span asp-validation-for="UserName" class="text-warning small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label auth-label"></label>
                <input asp-for="Email" class="form-control auth-input" autocomplete="email" placeholder="mail@ornek.com" />
                <span asp-validation-for="Email" class="text-warning small"></span>
            </div>

            <button type="submit" class="btn btn-primary auth-btn w-100 mb-3">Sifre Yenileme Linki Olustur</button>

            @if (ViewBag.ResetLink != null && !string.IsNullOrWhiteSpace(ViewBag.ResetLink.ToString()))
            {
                <div class="mb-3">
                    <div class="text-white fw-semibold mb-2">Olusan baglanti</div>
                    <div class="reset-link-box mb-2">@ViewBag.ResetLink</div>
                    <a class="btn btn-outline-dark w-100" href="@ViewBag.ResetLink">Sifreyi Yenile Sayfasini Ac</a>
                </div>
            }

            <div class="text-center text-white-50">
                <a class="auth-link" asp-controller="Account" asp-action="Login">Giris ekranina don</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
