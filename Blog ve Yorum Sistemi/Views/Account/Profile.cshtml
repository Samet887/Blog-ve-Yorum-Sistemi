@model BireyselHesaplar.Models.User
@using BireyselHesaplar.Models
@using BireyselHesaplar.Utilities
@using System.Globalization

@{
    ViewData["Title"] = "Profil";

    var posts = ViewBag.ProfilePosts as List<BlogPost> ?? new List<BlogPost>();
    var isOwnProfile = ViewBag.IsOwnProfile != null && (bool)ViewBag.IsOwnProfile;
    var isAdmin = ViewBag.IsAdmin != null && (bool)ViewBag.IsAdmin;
    var isBlocked = ViewBag.IsBlocked != null && (bool)ViewBag.IsBlocked;
    var activeBan = ViewBag.ActiveBan as UserBan;
    var isBanned = activeBan != null;
    var isTargetPrivileged = string.Equals(Model.Role, "Admin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(Model.Role, "Moderator", StringComparison.OrdinalIgnoreCase);
    var profileRoleLabel = string.Equals(Model.Role, "Admin", StringComparison.OrdinalIgnoreCase)
        ? "Yönetici"
        : (string.Equals(Model.Role, "Moderator", StringComparison.OrdinalIgnoreCase) ? "Moderatör" : "Üye");
    var firstLetter = string.IsNullOrWhiteSpace(Model.UserName) ? "?" : Model.UserName.Substring(0, 1).ToUpperInvariant();
    var tr = new CultureInfo("tr-TR");
    var profileReturnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<style>
    .profile-hero {
        border: 1px solid var(--app-border-soft, #ddd6ca);
        background: #fff;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 10px 28px rgba(18, 22, 33, 0.08);
    }

    .profile-avatar-wrap {
        position: relative;
        width: 112px;
        height: 112px;
        flex: 0 0 auto;
    }

    .profile-avatar {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #d8dbe3;
    }

    .profile-avatar-fallback {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        border: 2px solid #d8dbe3;
        background: #1f2937;
        color: #fff;
        font-size: 2rem;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .profile-avatar-edit {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 32px;
        height: 32px;
        border: 1px solid #d8dbe3;
        border-radius: 50%;
        background: #fff;
        color: #25324a;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .profile-avatar-edit:hover {
        background: #f6f8fc;
    }

    .profile-name {
        font-size: clamp(1.6rem, 2.3vw, 2rem);
        margin-bottom: 4px;
    }

    .profile-meta {
        color: #667086;
    }

    .profile-action-btn {
        border-radius: 10px;
        border: 1px solid #101726;
        background: #101726;
        color: #fff;
        font-weight: 700;
        padding: 9px 14px;
        font-size: .84rem;
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: .18s ease;
    }

    .profile-action-btn:hover {
        background: #1b2740;
        border-color: #1b2740;
        color: #fff;
        transform: translateY(-1px);
    }

    .profile-action-light {
        border-color: #cfd6e3;
        background: #fff;
        color: #25324a;
    }

    .profile-action-light:hover {
        border-color: #b7c2d6;
        background: #f8f9fc;
        color: #1a2437;
    }

    .profile-action-danger {
        border-color: #dc2626;
        background: #fff;
        color: #dc2626;
    }

    .profile-action-danger:hover {
        border-color: #dc2626;
        background: #dc2626;
        color: #fff;
    }

    .profile-action-success {
        border-color: #15803d;
        background: #15803d;
        color: #fff;
    }

    .profile-action-success:hover {
        border-color: #166534;
        background: #166534;
        color: #fff;
    }

    .stat-card {
        min-width: 148px;
        border: 1px solid #e3e7ef;
        border-radius: 12px;
        background: #f9fbff;
        text-align: center;
        padding: 14px;
    }

    .profile-post-card {
        border: 1px solid #e0e4ec;
        border-radius: 14px;
        overflow: hidden;
    }

    .profile-post-grid {
        display: grid;
        grid-template-columns: 128px 1fr;
        gap: 16px;
    }

    .profile-post-thumb,
    .profile-post-thumb-fallback {
        width: 128px;
        height: 128px;
        border-radius: 12px;
        object-fit: cover;
    }

    .profile-post-thumb-fallback {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4f5e7d;
        font-size: .82rem;
        font-weight: 700;
        background: linear-gradient(145deg, #eef2f8, #dce4f2);
    }

    .profile-post-meta {
        color: #6b7588;
    }

    .profile-post-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .profile-icon-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        color: #3f4a61;
        transition: .16s ease;
    }

    .profile-icon-btn:hover {
        transform: translateY(-1px);
        background: #f0f4fb;
    }

    .profile-icon-read:hover { color: #2563eb; }
    .profile-icon-edit:hover { color: #b45309; }
    .profile-icon-delete:hover { color: #dc2626; }

    .post-preview {
        color: #25324a;
        line-height: 1.6;
        font-size: .95rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .profile-section-card {
        border: 1px solid #e0e4ec;
        border-radius: 12px;
        background: #fff;
    }

    @@media (max-width: 767.98px) {
        .profile-post-grid {
            grid-template-columns: 1fr;
        }

        .profile-post-thumb,
        .profile-post-thumb-fallback {
            width: 100%;
            height: 180px;
        }
    }
</style>

<div class="profile-hero mb-4">
    <div class="d-flex flex-column flex-xl-row justify-content-between gap-4">
        <div class="d-flex gap-4">
            <div class="profile-avatar-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                {
                    <img src="@Model.ProfileImageUrl" alt="Profil fotoğrafı" class="profile-avatar" />
                }
                else
                {
                    <span class="profile-avatar-fallback">@firstLetter</span>
                }

                @if (isOwnProfile)
                {
                    <button type="button" class="profile-avatar-edit" data-bs-toggle="collapse" data-bs-target="#profilePhotoPanel" aria-expanded="false" title="Profil fotoğrafını değiştir">
                        <i class="bi bi-camera"></i>
                    </button>
                }
            </div>

            <div>
                <h1 class="profile-name fw-bold">@Model.UserName</h1>
                <div class="profile-meta mb-1">@Model.FullName · @profileRoleLabel</div>
                <div class="profile-meta mb-3">@Model.Email</div>

                <div class="d-flex flex-wrap gap-2">
                    @if (isOwnProfile)
                    {
                        <a asp-controller="Blog" asp-action="Create" class="btn profile-action-btn"><i class="bi bi-pencil-square"></i>Yeni Gönderi</a>
                        <button type="button" class="btn profile-action-btn profile-action-light" data-bs-toggle="collapse" data-bs-target="#changePasswordPanel" aria-expanded="false">
                            <i class="bi bi-shield-lock"></i>
                            Şifre Değiştir
                        </button>
                    }
                    else if (isAdmin)
                    {
                        @if (isBanned)
                        {
                            <form asp-controller="Admin" asp-action="UnbanUser" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userId" value="@Model.Id" />
                                <button type="submit" class="btn profile-action-btn profile-action-success"><i class="bi bi-unlock"></i>Banı Kaldır</button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn profile-action-btn profile-action-danger" data-bs-toggle="modal" data-bs-target="#banUserModal">
                                <i class="bi bi-slash-circle"></i>
                                Banla
                            </button>
                        }

                        <form asp-controller="Admin" asp-action="DeleteUser" method="post" class="d-inline"
                              data-confirm="Bu kullanıcıyı ve tüm ilişkili verilerini silmek istediğinize emin misiniz?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="userId" value="@Model.Id" />
                            <button type="submit" class="btn profile-action-btn profile-action-danger"><i class="bi bi-trash3"></i>Kullanıcıyı Sil</button>
                        </form>
                    }
                    else
                    {
                        @if (!isTargetPrivileged)
                        {
                        <form asp-action="ToggleBlock" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="blockedUserId" value="@Model.Id" />
                            <button type="submit" class="btn profile-action-btn @(isBlocked ? "profile-action-light" : "profile-action-danger")">
                                <i class="bi @(isBlocked ? "bi-check2-circle" : "bi-slash-circle")"></i>
                                @(isBlocked ? "Engeli Kaldır" : "Kullanıcıyı Engelle")
                            </button>
                        </form>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="d-flex gap-3 flex-wrap align-self-start">
            <div class="stat-card">
                <div class="fs-2 fw-bold">@posts.Count</div>
                <div class="text-muted">Gönderi</div>
            </div>
            <div class="stat-card">
                <div class="fs-6 fw-bold">@Model.CreatedAt.ToString("d MMMM yyyy", tr)</div>
                <div class="text-muted">Kayıt Tarihi</div>
            </div>
        </div>
    </div>
</div>

@if (isBanned)
{
    <div class="alert alert-warning">
        Bu kullanıcı banlı. Sebep: <strong>@activeBan!.Reason</strong> | Bitiş: <strong>@activeBan.ExpiresAt.ToString("dd.MM.yyyy HH:mm")</strong>
    </div>
}

@if (isOwnProfile)
{
    <div id="changePasswordPanel" class="collapse mb-3">
        <div class="card profile-section-card">
            <div class="card-body">
                <h5 class="mb-3">Şifre Değiştir</h5>
                <form asp-action="ChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 align-items-end">
                        <div class="col-md-4">
                            <label class="form-label">Mevcut şifre</label>
                            <input type="password" name="currentPassword" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Yeni şifre</label>
                            <input type="password" name="newPassword" class="form-control" minlength="6" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Yeni şifre (tekrar)</label>
                            <input type="password" name="confirmNewPassword" class="form-control" minlength="6" required />
                        </div>
                        <div class="col-12 text-end">
                            <button type="submit" class="btn profile-action-btn"><i class="bi bi-check2"></i>Şifreyi Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="profilePhotoPanel" class="collapse mb-4">
        <div class="card profile-section-card">
            <div class="card-body">
                <h5 class="mb-3">Profil Fotoğrafını Güncelle</h5>
                <form asp-action="ChangeProfileImage" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="row g-3 align-items-end">
                        <div class="col-lg-8">
                            <input type="file" name="profileImage" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif,image/*" required />
                        </div>
                        <div class="col-lg-4 text-lg-end">
                            <button type="submit" class="btn profile-action-btn w-100"><i class="bi bi-upload"></i>Fotoğrafı Yükle</button>
                        </div>
                    </div>
                </form>

                @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                {
                    <form asp-action="RemoveProfileImage" method="post" class="mt-3"
                          data-confirm="Profil fotoğrafını kaldırmak istediğine emin misin?">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="col-lg-4 ms-lg-auto text-lg-end">
                                <button type="submit" class="btn profile-action-btn profile-action-danger w-100"><i class="bi bi-x-lg"></i>Fotoğrafı Kaldır</button>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <h2 class="mb-1">Gönderiler</h2>
        <div class="text-muted">Kullanıcının paylaşımları</div>
    </div>
</div>

@if (posts.Any())
{
    <div class="row g-3">
        @foreach (var post in posts)
        {
            var commentCount = post.Comments?.Count ?? 0;
            var likeCount = post.Likes?.Count ?? 0;
            var previewText = TextFormat.SanitizeHtml(post.Content);
            var hasImage = !string.IsNullOrWhiteSpace(post.ImageUrl);
            <div class="col-12">
                <div class="card border-0 profile-post-card">
                    <div class="card-body">
                        <div class="profile-post-grid">
                            <div>
                                @if (hasImage)
                                {
                                    <img src="@post.ImageUrl" alt="Kapak görseli" class="profile-post-thumb" />
                                }
                                else
                                {
                                    <div class="profile-post-thumb-fallback">Kapak Görseli</div>
                                }
                            </div>

                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <h4 class="mb-2">@Html.Raw(TextFormat.SanitizeHtml(post.Title))</h4>
                                    <small class="profile-post-meta text-nowrap">@post.CreatedAt.ToString("d MMMM yyyy, HH:mm", tr)</small>
                                </div>

                                <div class="post-preview mb-3">@Html.Raw(previewText)</div>
                                <div class="profile-post-meta mb-2">@commentCount yorum · @likeCount beğeni</div>

                                <div class="profile-post-actions">
                                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@post.Id" class="profile-icon-btn profile-icon-read" title="Detay" aria-label="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (isOwnProfile || isAdmin)
                                    {
                                        <a asp-controller="Blog" asp-action="Edit" asp-route-id="@post.Id" class="profile-icon-btn profile-icon-edit" title="Düzenle" aria-label="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-controller="Blog" asp-action="Delete" method="post" class="d-inline"
                                              data-confirm="Gönderiyi silmek istediğinize emin misiniz?">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@post.Id" />
                                            <input type="hidden" name="returnUrl" value="@profileReturnUrl" />
                                            <button type="submit" class="profile-icon-btn profile-icon-delete" title="Sil" aria-label="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info mb-0">Henüz gönderi bulunmuyor.</div>
}

@if (!isOwnProfile && isAdmin && !isBanned)
{
    <div class="modal fade" id="banUserModal" tabindex="-1" aria-labelledby="banUserModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="banUserForm" asp-controller="Admin" asp-action="BanUser" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userId" value="@Model.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="banUserModalLabel">Kullanıcıyı Banla</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Süre</label>
                            <select name="durationDays" class="form-select" required>
                                <option value="1">1 gün</option>
                                <option value="3">3 gün</option>
                                <option value="7" selected>7 gün</option>
                                <option value="15">15 gün</option>
                                <option value="30">30 gün</option>
                            </select>
                        </div>
                        <div>
                            <label class="form-label">Ban nedeni</label>
                            <input name="reason" class="form-control" placeholder="Ban nedeni" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                        <button id="banUserSubmitButton" type="submit" class="btn btn-danger">Banla</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            const banForm = document.getElementById("banUserForm");
            const submitButton = document.getElementById("banUserSubmitButton");

            if (!banForm || !submitButton) {
                return;
            }

            banForm.addEventListener("submit", function (event) {
                if (!banForm.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                    banForm.classList.add("was-validated");
                    return;
                }

                submitButton.disabled = true;
                submitButton.textContent = "Banlanıyor...";
            });
        })();
    </script>
}
