@{
    var username = (ViewData["Username"] as string) ?? string.Empty;
    var profileImageUrl = ViewData["ProfileImageUrl"] as string;
    var initial = string.IsNullOrWhiteSpace(username) ? "?" : username.Substring(0, 1).ToUpperInvariant();
}

@if (!string.IsNullOrWhiteSpace(username))
{
    <a asp-controller="Account" asp-action="UserProfile" asp-route-username="@username"
       class="d-inline-flex align-items-center gap-2 text-decoration-none">
        @if (!string.IsNullOrWhiteSpace(profileImageUrl))
        {
            <img src="@profileImageUrl" alt="@username"
                 style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:1px solid #e2e8f0;" />
        }
        else
        {
            <span class="d-inline-flex align-items-center justify-content-center fw-bold text-white"
                  style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#2563eb,#7c3aed);font-size:13px;">
                @initial
            </span>
        }
        <span class="text-dark small fw-semibold">@username</span>
    </a>
}
