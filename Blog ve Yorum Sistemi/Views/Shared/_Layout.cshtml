@{
    var userId = Context.Session.GetInt32("UserId");
    var userName = Context.Session.GetString("UserName");
    var userRole = Context.Session.GetString("UserRole");
    var isAdmin = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase)
        || string.Equals(userRole, "Moderator", StringComparison.OrdinalIgnoreCase);
    var adminLabel = string.Equals(userRole, "Admin", StringComparison.OrdinalIgnoreCase)
        ? "(Yönetici)"
        : (string.Equals(userRole, "Moderator", StringComparison.OrdinalIgnoreCase) ? "(Moderatör)" : "");
    var profileBadgeText = userId != null
        ? $"Merhaba, {userName} {adminLabel}".Trim()
        : string.Empty;
    var isLongProfileBadge = !string.IsNullOrWhiteSpace(profileBadgeText) && profileBadgeText.Length > 26;
    var hideChrome = ViewData["HideChrome"] as bool? ?? false;
    var fullWidth = ViewData["FullWidth"] as bool? ?? false;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blogghanem </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Lora:wght@600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <style>
        :root {
            --app-cream: #FCFDF5;
            --app-dark: #1A1E2B;
            --app-purple: #6366F1;
            --app-green: #10B981;
            --app-danger: #EF4444;
            --app-ink: #2F3C5F;
            --app-muted: #6b7280;
            --app-border: #d9dfeb;
            --app-surface: #ffffff;
            --app-shadow: 0 18px 36px rgba(26, 30, 43, 0.08);
        }

        body {
            font-family: "Montserrat", "Segoe UI", sans-serif;
            background: var(--app-cream);
            color: var(--app-ink);
            min-height: 100vh;
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: "Lora", "Georgia", serif;
            letter-spacing: 0;
        }

        .navbar-custom {
            background: var(--app-dark);
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.35rem;
            color: #fff;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            text-decoration: none;
        }

        .navbar-brand:hover {
            color: #f8fafc;
        }

        .brand-text, .brand-text span {
            color: #fff;
            -webkit-text-fill-color: #fff;
            background: none;
            text-shadow: none;
        }

        .nav-link {
            color: rgba(255, 255, 255, 0.84) !important;
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            padding: 10px 12px !important;
            transition: color .2s ease;
        }

        .nav-link:hover {
            color: #fff !important;
            background: transparent;
        }

        .profile-badge {
            border: 1px solid rgba(255, 255, 255, 0.36);
            background: rgba(255, 255, 255, 0.08);
            color: #fff;
            padding: 7px 12px;
            border-radius: 10px;
            font-size: .78rem;
            font-weight: 700;
            letter-spacing: .4px;
            text-transform: uppercase;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            min-width: 0;
            max-width: min(360px, 48vw);
        }

        .profile-badge-text {
            display: block;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            min-width: 0;
        }

        .profile-badge:hover {
            color: #fff;
            background: rgba(255, 255, 255, 0.14);
            text-decoration: none;
        }

        .btn-soft-light, .btn-register {
            border-radius: 10px;
            padding: 8px 14px;
            font-weight: 700;
            font-size: .78rem;
            letter-spacing: .4px;
            text-transform: uppercase;
        }

        .nav-user-search {
            position: relative;
            width: min(340px, 100%);
        }

        .nav-user-search .form-control {
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.3);
            background: rgba(255, 255, 255, 0.96);
            min-width: 220px;
            font-size: .88rem;
        }

        .search-suggest {
            position: absolute;
            top: calc(100% + 8px);
            left: 0;
            right: 0;
            z-index: 1200;
            border-radius: 12px;
            border: 1px solid var(--app-border);
            background: #fff;
            box-shadow: var(--app-shadow);
            padding: 8px;
            display: none;
            max-height: 320px;
            overflow-y: auto;
        }

        .search-suggest.show {
            display: block;
        }

        .search-suggest-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            color: var(--app-ink);
            text-decoration: none;
            border-radius: 10px;
        }

        .search-suggest-item:hover {
            background: #f2f5fb;
            color: #1e2b49;
            text-decoration: none;
        }

        .search-suggest-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            object-fit: cover;
            flex: 0 0 34px;
            border: 1px solid #c9d3e4;
            background: #2b2b2b;
            color: #fff;
            font-size: 0.85rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .main-content {
            min-height: calc(100vh - 180px);
            padding-top: 24px;
            padding-bottom: 16px;
        }

        .main-container {
            max-width: 1320px;
        }

        .main-container.main-container-full {
            max-width: 100%;
            padding-left: 20px;
            padding-right: 20px;
        }

        .page-shell {
            background: transparent;
            border: none;
            box-shadow: none;
            padding: 0;
        }

        body:not(.auth-mode) .card,
        body:not(.auth-mode) .table,
        body:not(.auth-mode) .list-group-item,
        body:not(.auth-mode) .modal-content {
            border-radius: 12px !important;
            border-color: var(--app-border) !important;
            box-shadow: none !important;
        }

        body:not(.auth-mode) .form-control,
        body:not(.auth-mode) .form-select,
        body:not(.auth-mode) .btn {
            border-radius: 12px !important;
        }

        body:not(.auth-mode) .form-control:focus,
        body:not(.auth-mode) .form-select:focus {
            border-color: var(--app-purple) !important;
            box-shadow: 0 0 0 .18rem rgba(99, 102, 241, .16) !important;
        }

        .alert {
            border-radius: 12px;
            border: 1px solid var(--app-border);
            box-shadow: none;
        }

        .footer {
            margin-top: 28px;
            padding: 20px 0 28px 0;
            color: var(--app-muted);
        }

        .footer-box {
            background: rgba(255, 255, 255, 0.8);
            border: 1px solid var(--app-border);
            border-radius: 12px;
            padding: 14px;
            box-shadow: none;
        }

        @@media (max-width: 991.98px) {
            .main-container {
                max-width: 100%;
            }

            .profile-badge {
                display: inline-block;
                margin-top: 8px;
            }
        }

        @@media (min-width: 992px) {
            .navbar-custom.navbar-compact-user .navbar-brand {
                margin-right: 14px;
                flex: 0 0 auto;
            }

            .navbar-custom.navbar-compact-user .nav-link {
                white-space: nowrap;
                font-size: .76rem;
                padding: 8px 8px !important;
            }

            .navbar-custom.navbar-compact-user .nav-user-search {
                width: min(250px, 100%);
            }

            .navbar-custom.navbar-compact-user .profile-badge {
                max-width: min(220px, 26vw);
            }
        }
    </style>
</head>
<body class="@(hideChrome ? "auth-mode" : "site-mode")">
    @if (!hideChrome)
    {
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom sticky-top @(isLongProfileBadge ? "navbar-compact-user" : "")">
            <div class="container">
                <a class="navbar-brand" asp-controller="Blog" asp-action="Index">
                    <span class="brand-text">Blog<span>App</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Menüyü aç">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse mt-2 mt-lg-0" id="mainNavbar">
                    @if (userId != null)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-2">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Blog" asp-action="Index">Ana Sayfa</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Blog" asp-action="Create">Yeni Gönderi</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Profile">Profil</a>
                            </li>
                            @if (isAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Index">Yönetim Paneli</a>
                                </li>
                            }
                        </ul>

                        <form asp-controller="Account" asp-action="SearchUsers" method="get" class="nav-user-search me-lg-2 mt-3 mt-lg-0">
                            <input id="navUserSearchInput"
                                   name="q"
                                   class="form-control form-control-sm"
                                   placeholder="Kullanıcı ara..."
                                   autocomplete="off" />
                            <div id="navUserSearchSuggest" class="search-suggest"></div>
                        </form>

                        <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 mt-3 mt-lg-0">
                            <a class="profile-badge" asp-controller="Account" asp-action="Profile" title="@profileBadgeText">
                                <span class="profile-badge-text">@profileBadgeText</span>
                            </a>
                            <a class="btn btn-outline-light btn-sm btn-soft-light" asp-controller="Account" asp-action="Logout">Çıkış</a>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-2">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm btn-register" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    }

    @if (hideChrome)
    {
        @RenderBody()
    }
    else
    {
        <main class="main-content">
            <div class="@(fullWidth ? "container-fluid main-container main-container-full" : "container main-container")">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>
                }

                <div class="page-shell">
                    @RenderBody()
                </div>
            </div>
        </main>

        <footer class="footer">
            <div class="container">
                <div class="footer-box text-center">
                    <small>&copy; 2026 BloggApp</small>
                </div>
            </div>
        </footer>
    }

    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title">İşlem Onayı</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p id="confirmActionMessage" class="mb-0">Bu işlemi yapmak istediğine emin misin?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="button" id="confirmActionOkBtn" class="btn btn-danger">Devam Et</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        button.btn:not(.btn-close):not(.navbar-toggler),
        a.btn,
        .admin-btn,
        .action-icon-btn,
        .studio-btn,
        .btn-home,
        .feed-icon-btn,
        .profile-action-btn,
        .profile-icon-btn,
        .profile-avatar-edit,
        .btn-register,
        .btn-soft-light {
            box-shadow: none !important;
            font-weight: 700;
            letter-spacing: .01em;
            transition: background-color .16s ease, color .16s ease, border-color .16s ease, transform .16s ease, box-shadow .16s ease;
        }

        button.btn:not(.btn-close):not(.navbar-toggler):hover,
        button.btn:not(.btn-close):not(.navbar-toggler):focus-visible,
        a.btn:hover,
        a.btn:focus-visible,
        .admin-btn:hover,
        .admin-btn:focus-visible,
        .action-icon-btn:hover,
        .action-icon-btn:focus-visible,
        .studio-btn:hover,
        .studio-btn:focus-visible,
        .btn-home:hover,
        .btn-home:focus-visible,
        .feed-icon-btn:hover,
        .feed-icon-btn:focus-visible,
        .profile-action-btn:hover,
        .profile-action-btn:focus-visible,
        .profile-icon-btn:hover,
        .profile-icon-btn:focus-visible,
        .profile-avatar-edit:hover,
        .profile-avatar-edit:focus-visible,
        .btn-register:hover,
        .btn-register:focus-visible,
        .btn-soft-light:hover,
        .btn-soft-light:focus-visible {
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(26, 30, 43, 0.14);
        }

        .btn-primary,
        .studio-btn-primary,
        .btn-home-primary,
        .hero-action-btn.primary,
        .admin-btn-dark {
            background: var(--app-dark) !important;
            border-color: var(--app-dark) !important;
            color: #fff !important;
        }

        .btn-primary:hover,
        .btn-primary:focus-visible,
        .studio-btn-primary:hover,
        .studio-btn-primary:focus-visible,
        .btn-home-primary:hover,
        .btn-home-primary:focus-visible,
        .hero-action-btn.primary:hover,
        .hero-action-btn.primary:focus-visible,
        .admin-btn-dark:hover,
        .admin-btn-dark:focus-visible {
            background: #111827 !important;
            border-color: #111827 !important;
            color: #fff !important;
        }

        .btn-register {
            background: var(--app-green) !important;
            border-color: var(--app-green) !important;
            color: #fff !important;
        }

        .btn-register:hover,
        .btn-register:focus-visible {
            background: #0f9f71 !important;
            border-color: #0f9f71 !important;
            color: #fff !important;
        }

        .btn-outline-secondary,
        .btn-home-light,
        .studio-btn-soft,
        .btn-soft-light {
            background: #fff !important;
            border-color: var(--app-border) !important;
            color: var(--app-ink) !important;
        }

        .btn-outline-secondary:hover,
        .btn-outline-secondary:focus-visible,
        .btn-home-light:hover,
        .btn-home-light:focus-visible,
        .studio-btn-soft:hover,
        .studio-btn-soft:focus-visible,
        .btn-soft-light:hover,
        .btn-soft-light:focus-visible {
            background: #f7f9ff !important;
            border-color: #c5d0e6 !important;
            color: #1f2b45 !important;
        }

        .btn-outline-primary,
        .preview-action-btn,
        #jumpPreviewBtn {
            background: #fff !important;
            border-color: var(--app-purple) !important;
            color: var(--app-purple) !important;
        }

        .btn-outline-primary:hover,
        .btn-outline-primary:focus-visible,
        .preview-action-btn:hover,
        .preview-action-btn:focus-visible,
        #jumpPreviewBtn:hover,
        #jumpPreviewBtn:focus-visible {
            background: var(--app-purple) !important;
            border-color: var(--app-purple) !important;
            color: #fff !important;
        }

        .btn-danger,
        #confirmActionOkBtn {
            background: var(--app-danger) !important;
            border-color: var(--app-danger) !important;
            color: #fff !important;
        }

        .btn-danger:hover,
        .btn-danger:focus-visible,
        #confirmActionOkBtn:hover,
        #confirmActionOkBtn:focus-visible {
            background: #dc2626 !important;
            border-color: #dc2626 !important;
            color: #fff !important;
        }

        .btn-outline-danger,
        .action-delete {
            background: #fff !important;
            border-color: var(--app-danger) !important;
            color: var(--app-danger) !important;
        }

        .btn-outline-danger:hover,
        .btn-outline-danger:focus-visible,
        .action-delete:hover,
        .action-delete:focus-visible {
            background: var(--app-danger) !important;
            border-color: var(--app-danger) !important;
            color: #fff !important;
        }

        .feed-btn-like.liked,
        .detail-like-btn.active,
        .home-chip.active,
        .chip.active {
            background: var(--app-purple) !important;
            border-color: var(--app-purple) !important;
            color: #fff !important;
        }

        .metric-trend {
            color: var(--app-green) !important;
        }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const input = document.getElementById("navUserSearchInput");
            const box = document.getElementById("navUserSearchSuggest");

            if (!input || !box) {
                return;
            }

            let abortController = null;

            function clearSuggestions() {
                box.innerHTML = "";
                box.classList.remove("show");
            }

            function escapeHtml(value) {
                return (value || "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#39;");
            }

            function renderUser(user) {
                const username = escapeHtml(user.userName || "");
                const fullName = escapeHtml(user.fullName || "");
                const imageUrl = user.profileImageUrl || "";
                const firstLetter = username ? username[0].toUpperCase() : "?";
                const avatar = imageUrl
                    ? `<img class="search-suggest-avatar" src="${escapeHtml(imageUrl)}" alt="pp" />`
                    : `<div class="search-suggest-avatar">${firstLetter}</div>`;

                return `
                    <a class="search-suggest-item" href="/Account/UserProfile?username=${encodeURIComponent(user.userName || "")}">
                        ${avatar}
                        <div>
                            <div class="fw-semibold small">${username}</div>
                            <div class="text-muted" style="font-size:.75rem;">${fullName}</div>
                        </div>
                    </a>
                `;
            }

            async function fetchSuggestions(term) {
                if (abortController) {
                    abortController.abort();
                }

                abortController = new AbortController();

                try {
                    const response = await fetch(`/Account/SearchUsersApi?q=${encodeURIComponent(term)}`, {
                        signal: abortController.signal
                    });

                    if (!response.ok) {
                        clearSuggestions();
                        return;
                    }

                    const users = await response.json();
                    if (!Array.isArray(users) || users.length === 0) {
                        clearSuggestions();
                        return;
                    }

                    box.innerHTML = users.map(renderUser).join("");
                    box.classList.add("show");
                } catch {
                    clearSuggestions();
                }
            }

            input.addEventListener("input", function () {
                const term = (input.value || "").trim();
                if (term.length < 2) {
                    clearSuggestions();
                    return;
                }

                fetchSuggestions(term);
            });

            document.addEventListener("click", function (event) {
                if (!box.contains(event.target) && event.target !== input) {
                    clearSuggestions();
                }
            });
        })();

        (function () {
            const modalEl = document.getElementById("confirmActionModal");
            const messageEl = document.getElementById("confirmActionMessage");
            const okBtn = document.getElementById("confirmActionOkBtn");

            if (!modalEl || !messageEl || !okBtn || typeof bootstrap === "undefined") {
                return;
            }

            const confirmModal = new bootstrap.Modal(modalEl);
            let pendingAction = null;

            function openConfirm(message, action) {
                messageEl.textContent = message || "Bu işlemi yapmak istediğine emin misin?";
                pendingAction = action;
                confirmModal.show();
            }

            okBtn.addEventListener("click", function () {
                if (typeof pendingAction === "function") {
                    pendingAction();
                }

                pendingAction = null;
                confirmModal.hide();
            });

            modalEl.addEventListener("hidden.bs.modal", function () {
                pendingAction = null;
            });

            document.addEventListener("submit", function (event) {
                const form = event.target;
                if (!(form instanceof HTMLFormElement)) {
                    return;
                }

                const confirmMessage = form.dataset.confirm;
                if (!confirmMessage) {
                    return;
                }

                if (form.dataset.confirmApproved === "1") {
                    form.dataset.confirmApproved = "";
                    return;
                }

                event.preventDefault();
                openConfirm(confirmMessage, function () {
                    form.dataset.confirmApproved = "1";
                    if (typeof form.requestSubmit === "function") {
                        form.requestSubmit();
                    } else {
                        form.submit();
                    }
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
