@model List<BireyselHesaplar.Models.BlogPost>

@{
    ViewData["Title"] = "Blog Listesi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Blog Listesi</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Blog Ekle</a>
</div>

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Başlık</th>
                <th>Tarih</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.Raw(BireyselHesaplar.Utilities.TextFormat.SanitizeHtml(item.Title))</td>
                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detay</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Güncelle</a>

                        <!-- SİL -->
                        <form asp-action="Delete" method="post" style="display:inline;" data-confirm="Silmek istediğinize emin misiniz?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">
                                Sil
                            </button>
                        </form>

                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-info">
        Henüz blog yok.
    </div>
}
