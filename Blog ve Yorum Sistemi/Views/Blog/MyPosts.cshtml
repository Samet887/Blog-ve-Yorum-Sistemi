@model List<BireyselHesaplar.Models.BlogPost>

@{
    ViewData["Title"] = "Benim Yazılarım";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Benim Yazılarım</h2>
        <a asp-action="Create" class="btn btn-primary">Yeni Blog Ekle</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Başlık</th>
                <th>Oluşturulma</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.Raw(BireyselHesaplar.Utilities.TextFormat.SanitizeHtml(item.Title))</td>
                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">Detay</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Güncelle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
